<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Web SDK's build time static web assets pipeline stamps every wwwroot file,
         including index.html, with "Cache-Control: max-age=31536000, immutable", a
         policy meant for fingerprinted/hashed asset URLs that never change under the same
         name. index.html has no such hash in its URL and its content changes every release,
         so a browser that ever loaded the dashboard once caches that exact page for a full
         year and never re-requests it, even after reinstalling a newer build server side.
         Confirmed live: two consecutive layout fixes were invisible in the browser because
         of exactly this. Disabling the feature reverts to plain static file serving with
         ASP.NET Core's normal, non-aggressive default caching, which is correct for a
         single-user LAN dashboard with no CDN in front of it. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ffmpeg.exe" Condition="Exists('ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Local publish output folders live inside the project root but aren't app source.
         Without this exclude, the Web SDK's default Content glob ("**", minus bin/obj) picks
         up any stray publish-star folder here, including real dev data like a leftover
         data/settings.json from a previous manual "dotnet publish -o publish-local", and
         re-embeds it into the next publish output. Found live: publish-local/data/settings.json
         (Jason's own printer host and password hash) was leaking into a fresh installer publish
         before this was added. -->
    <Content Remove="publish/**" />
    <Content Remove="publish-local/**" />
    <Content Remove="publish-installer/**" />
    <Content Remove="publish-installer-sf/**" />
  </ItemGroup>

</Project>
